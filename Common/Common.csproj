        <Folder Include="Projectiles\" />
    </ItemGroup>

    <!-- Game data XMLs come from the sibling AlloyClient repo: its ContentExalt folder (made locally
         by AlloyClient's tools/exalt_import from your RotMG install) when present, otherwise its
         Content folder. Wildcard, so new files from a data update are picked up automatically. -->
    <PropertyGroup>
        <AlloyClientXmls Condition="Exists('$(MSBuildThisFileDirectory)..\..\AlloyClient\AlloyClient\ContentExalt\Xmls')">$(MSBuildThisFileDirectory)..\..\AlloyClient\AlloyClient\ContentExalt\Xmls</AlloyClientXmls>
        <AlloyClientXmls Condition="'$(AlloyClientXmls)' == ''">$(MSBuildThisFileDirectory)..\..\AlloyClient\AlloyClient\Content\Xmls</AlloyClientXmls>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="$(AlloyClientXmls)\*.xml">
        <Link>Resources\Xml\Data\Xmls\%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <!-- Every world config and map in Resources\World\Data is copied, so a new dungeon only needs
         its .json and .jm dropped in (for example from AlloyClient's tools/recorder). -->
    <ItemGroup>
      <None Update="Resources\World\Data\**\*.json;Resources\World\Data\**\*.jm;Resources\World\Data\**\*.wmap">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <!-- Remove previously copied XMLs first, so files dropped or renamed by a data update
         don't linger in the server's output and load twice. -->
    <Target Name="CleanAlloyXmls" BeforeTargets="CopyFilesToOutputDirectory">
        <RemoveDir Directories="$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\Resources\Xml\Data\Xmls" />
    </Target>

</Project>
